{
  "useCases": [
    {
      "name": "Process Payment with Return Values",
      "scenarios": [
        {
          "id": "scenario_1",
          "trigger": {
            "type": "external",
            "actor": "User",
            "verb": "submits",
            "phrase": "payment request",
            "description": "when User submits payment request"
          },
          "actions": [
            {
              "id": "action_2",
              "type": "internal_action",
              "domain": "PaymentService",
              "verb": "validates",
              "phrase": "payment data",
              "description": "PaymentService validates payment data",
              "line": 3
            },
            {
              "id": "action_3",
              "type": "sync_action",
              "domain": "PaymentService",
              "targetDomain": "BankGateway",
              "connector": "to",
              "phrase": "process payment",
              "description": "PaymentService asks BankGateway to process payment",
              "line": 4
            },
            {
              "id": "action_4",
              "type": "return_action",
              "domain": "BankGateway",
              "targetDomain": "PaymentService",
              "phrase": "payment result",
              "description": "BankGateway returns payment result to PaymentService",
              "line": 5
            },
            {
              "id": "action_5",
              "type": "return_action",
              "domain": "PaymentService",
              "targetDomain": "User",
              "phrase": "confirmation status",
              "description": "PaymentService returns confirmation status to User",
              "line": 6
            },
            {
              "id": "action_6",
              "type": "async_action",
              "domain": "PaymentService",
              "event": "payment_processed",
              "description": "PaymentService notifies \"payment_processed\"",
              "line": 7
            }
          ]
        }
      ]
    },
    {
      "name": "User Registration with Validation",
      "scenarios": [
        {
          "id": "scenario_7",
          "trigger": {
            "type": "external",
            "actor": "User",
            "verb": "submits",
            "phrase": "registration form",
            "description": "when User submits registration form"
          },
          "actions": [
            {
              "id": "action_8",
              "type": "internal_action",
              "domain": "UserService",
              "verb": "validates",
              "phrase": "user data",
              "description": "UserService validates user data",
              "line": 12
            },
            {
              "id": "action_9",
              "type": "sync_action",
              "domain": "UserService",
              "targetDomain": "EmailService",
              "connector": "to",
              "phrase": "send verification",
              "description": "UserService asks EmailService to send verification",
              "line": 13
            },
            {
              "id": "action_10",
              "type": "return_action",
              "domain": "EmailService",
              "phrase": "email status",
              "description": "EmailService returns email status",
              "line": 14
            },
            {
              "id": "action_11",
              "type": "return_action",
              "domain": "UserService",
              "targetDomain": "User",
              "phrase": "registration result",
              "description": "UserService returns registration result to User",
              "line": 15
            }
          ]
        }
      ]
    }
  ]
}
