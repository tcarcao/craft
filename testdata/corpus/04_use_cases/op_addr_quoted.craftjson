{
  "useCases": [
    {
      "name": "obido analytics refreshes the market structure",
      "scenarios": [
        {
          "id": "scenario_1",
          "trigger": {
            "type": "external",
            "actor": "CRON",
            "schedule": "0 18 * * *",
            "scheduleKind": "cron",
            "description": "when cron \"0 18 * * *\"",
            "subject": {
              "kind": "actor",
              "id": "CRON"
            },
            "line": 12,
            "column": 10
          },
          "steps": [
            {
              "action": {
                "id": "action_2",
                "type": "sync_action",
                "context": "obidoanalytics",
                "targetContext": "ObjectStore",
                "ref": "ObjectStore",
                "operation": {
                  "verb": "ADDR",
                  "payload": "SNAPSHOT_DESTINATION",
                  "text": "ADDR \"SNAPSHOT_DESTINATION\""
                },
                "connector": "to",
                "phrase": "take the refreshed snapshot",
                "description": "obidoanalytics asks ObjectStore to take the refreshed snapshot",
                "line": 13,
                "column": 9,
                "from": {
                  "kind": "bounded_context",
                  "id": "obido/obidoanalytics"
                },
                "to": {
                  "kind": "actor",
                  "id": "ObjectStore"
                }
              }
            }
          ]
        }
      ],
      "line": 11
    }
  ],
  "domains": [
    {
      "name": "obido",
      "boundedContexts": [
        "obidoanalytics",
        "front"
      ]
    }
  ],
  "actors": [
    {
      "name": "CRON",
      "type": "system",
      "line": 2
    },
    {
      "name": "ObjectStore",
      "type": "system",
      "line": 3
    }
  ]
}
