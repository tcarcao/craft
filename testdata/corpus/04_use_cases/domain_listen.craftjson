{
  "useCases": [
    {
      "name": "Order Processing",
      "scenarios": [
        {
          "id": "scenario_1",
          "trigger": {
            "type": "external",
            "actor": "Customer",
            "verb": "places",
            "phrase": "order",
            "description": "when Customer places order"
          },
          "actions": [
            {
              "id": "action_2",
              "type": "internal_action",
              "domain": "OrderService",
              "verb": "validates",
              "phrase": "order details",
              "description": "OrderService validates order details",
              "line": 3
            },
            {
              "id": "action_3",
              "type": "async_action",
              "domain": "OrderService",
              "event": "Order Placed",
              "description": "OrderService notifies \"Order Placed\"",
              "line": 4
            }
          ]
        },
        {
          "id": "scenario_4",
          "trigger": {
            "type": "domain_listen",
            "domain": "Inventory",
            "event": "Order Placed",
            "description": "when Inventory listens \"Order Placed\""
          },
          "actions": [
            {
              "id": "action_5",
              "type": "internal_action",
              "domain": "Inventory",
              "verb": "checks",
              "phrase": "stock availability",
              "description": "Inventory checks stock availability",
              "line": 7
            },
            {
              "id": "action_6",
              "type": "async_action",
              "domain": "Inventory",
              "event": "Stock Reserved",
              "description": "Inventory notifies \"Stock Reserved\"",
              "line": 8
            }
          ]
        }
      ]
    }
  ]
}
