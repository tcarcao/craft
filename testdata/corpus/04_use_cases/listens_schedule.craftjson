    {
      "name": "Queued reminders are sent",
      "scenarios": [
        {
          "id": "scenario_3",
          "trigger": {
            "type": "domain_listen",
            "context": "smsdispatch",
            "event": "store.sms_queue.inserted",
            "ref": "store.sms_queue.inserted",
            "schedule": "* 10 * * 1-5",
            "scheduleKind": "cron",
            "store": {
              "name": "sms_queue",
              "change": "inserted"
            },
            "description": "when smsdispatch listens \"store.sms_queue.inserted\" cron \"* 10 * * 1-5\"",
            "subject": {
              "kind": "bounded_context",
              "id": "leads/smsdispatch"
            },
            "line": 14,
            "column": 10
          },
          "steps": [
            {
