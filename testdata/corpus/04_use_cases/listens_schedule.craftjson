                "id": "action_4",
                "type": "internal_action",
                "context": "smsdispatch",
                "verb": "claims",
                "connector": "the",
                "phrase": "unsent rows",
                "description": "smsdispatch claims the unsent rows",
                "line": 15,
                "column": 9,
                "from": {
                  "kind": "bounded_context",
                  "id": "leads/smsdispatch"
                }
