# Craft Web IDE Environment Variables
# Copy this file to .env and customize as needed

# Craft Extension Version
# Set to 'latest' to always use the newest release
# Or specify a version tag (e.g., v0.1.0) to pin to that version
CRAFT_VERSION=latest

# IDE Service URL (used by craft-server reverse proxy)
# Default: http://craft-ide:3000
# IDE_URL=http://craft-ide:3000

# Craft Server URL (used by IDE extension)
# Default: http://craft-server:8080
# CRAFT_SERVER_URL=http://craft-server:8080
