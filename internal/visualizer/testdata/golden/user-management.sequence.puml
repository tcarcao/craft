@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

actor "Business_User" as Business_User
participant "Authentication" as Authentication
control "Database" as Database
participant "Profile" as Profile
participant "Notifier" as Notifier

== User Registration ==

Business_User -> Authentication : creates Account
Authentication -> Authentication : validates email format
Authentication -> Database : to check email uniqueness
Profile -> Profile : creates user profile
Authentication ->> Authentication : notifies "User Registered"
Authentication ->> Profile : User Registered
Profile -> Database : to store profile data
Profile -> Notifier : to send welcome email

@enduml