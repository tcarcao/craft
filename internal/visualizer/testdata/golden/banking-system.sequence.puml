@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

actor "Customer" as Customer
participant "PaymentProcessing" as PaymentProcessing
participant "AccountManagement" as AccountManagement
actor "TransactionValidation" as TransactionValidation
participant "BalanceTracking" as BalanceTracking
participant "CustomerNotification" as CustomerNotification
actor "CRON" as CRON

== Money Transfer ==

group 1: when Customer initiates transfer
Customer -> PaymentProcessing : initiates transfer
PaymentProcessing -> AccountManagement : verify source account
PaymentProcessing -> TransactionValidation : check transfer limits
TransactionValidation -> TransactionValidation : validates transaction rules
PaymentProcessing -> BalanceTracking : reserve funds
BalanceTracking ->> BalanceTracking : notifies "Funds Reserved"
end
group 2: when PaymentProcessing listens "Funds Reserved"
BalanceTracking ->> PaymentProcessing : Funds Reserved
PaymentProcessing -> AccountManagement : verify destination account
PaymentProcessing -> PaymentProcessing : executes fund transfer
BalanceTracking -> BalanceTracking : updates account balances
PaymentProcessing ->> PaymentProcessing : notifies "Transfer Completed"
end
group 3: when CustomerNotification listens "Transfer Completed"
PaymentProcessing ->> CustomerNotification : Transfer Completed
CustomerNotification -> CustomerNotification : sends confirmation to both accounts
end

== Account Balance Check ==

Customer -> AccountManagement : checks balance
AccountManagement -> BalanceTracking : get current balance
BalanceTracking -> BalanceTracking : calculates available balance
AccountManagement --> Customer : returns balance information

== Suspicious Activity Detection ==

group 1: when TransactionValidation detects suspicious pattern
note over TransactionValidation : detects suspicious pattern
TransactionValidation -> AccountManagement : freeze account
AccountManagement -> AccountManagement : applies security hold
TransactionValidation ->> TransactionValidation : notifies "Account Frozen"
end
group 2: when CustomerNotification listens "Account Frozen"
TransactionValidation ->> CustomerNotification : Account Frozen
CustomerNotification -> CustomerNotification : sends security alert to customer
CustomerNotification ->> CustomerNotification : notifies "bank security team"
end

== Scheduled Payment Processing ==

CRON -> PaymentProcessing : triggers scheduled payments
PaymentProcessing -> AccountManagement : get scheduled payments
PaymentProcessing -> PaymentProcessing : processes each scheduled payment
BalanceTracking -> BalanceTracking : updates balances for processed payments
PaymentProcessing ->> PaymentProcessing : notifies "Scheduled Payments Processed"

@enduml