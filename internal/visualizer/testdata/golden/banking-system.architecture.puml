@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName SansSerif

' Subdomain styling with frames
skinparam frame {
  BackgroundColor #E6F3FF
  BorderColor #4A90E2
  BorderThickness 2
  FontColor black
  FontSize 12
  FontStyle bold
}

skinparam queue {
  BackgroundColor #FFE4B5
  BorderColor #666666
  FontSize 10
}

skinparam rectangle {
  BackgroundColor #F0F8FF
  BorderColor #4169E1
  BorderThickness 3
  FontColor #000080
  FontSize 14
  FontStyle bold
}

' Ungrouped subdomains
frame "AccountManagement" as AccountManagement
frame "BalanceTracking" as BalanceTracking
frame "CustomerNotification" as CustomerNotification
frame "PaymentProcessing" as PaymentProcessing
frame "TransactionValidation" as TransactionValidation

' Domain queues
queue "BalanceTracking events" as BalanceTracking_events
queue "CustomerNotification events" as CustomerNotification_events
queue "PaymentProcessing events" as PaymentProcessing_events
queue "TransactionValidation events" as TransactionValidation_events

' Subdomain connections
AccountManagement --> BalanceTracking
BalanceTracking --> BalanceTracking_events
CustomerNotification --> CustomerNotification_events
PaymentProcessing --> AccountManagement
PaymentProcessing --> BalanceTracking
PaymentProcessing --> TransactionValidation
PaymentProcessing --> PaymentProcessing_events
TransactionValidation --> AccountManagement
TransactionValidation --> TransactionValidation_events
BalanceTracking_events --> PaymentProcessing
PaymentProcessing_events --> CustomerNotification
TransactionValidation_events --> CustomerNotification

@enduml