C4Container
    title Container Diagram - Architecture (boundaries mode)
    Person(CRON, "CRON", "External user")
    Person(Customer, "Customer", "External user")
    Person(TransactionValidation, "TransactionValidation", "External user")
    Enterprise_Boundary(NotificationService_boundary, "NotificationService") {
        Container_Boundary(NotificationService_CustomerNotification_Domain_boundary, "CustomerNotification Domain") {
            Container_Ext(CustomerNotification, "CustomerNotification", "Python Application", "CustomerNotification [Context]")
        }
        ContainerDb_Ext(NotificationService_notification_queue, "NotificationService_notification_queue", "Database", "Stores notification_queue data")
    }
    Enterprise_Boundary(PaymentService_boundary, "PaymentService") {
        Container_Boundary(PaymentService_PaymentProcessing_Domain_boundary, "PaymentProcessing Domain") {
            Container_Ext(PaymentProcessing, "PaymentProcessing", "Go Application", "PaymentProcessing [Context]")
        }
        Container_Boundary(PaymentService_TransactionValidation_Domain_boundary, "TransactionValidation Domain") {
            Container_Ext(TransactionValidation, "TransactionValidation", "Go Application", "TransactionValidation [Context]")
        }
        ContainerDb_Ext(PaymentService_payment_db, "PaymentService_payment_db", "Database", "Stores payment_db data")
        ContainerDb_Ext(PaymentService_fraud_detection_cache, "PaymentService_fraud_detection_cache", "Redis Cache", "Stores fraud_detection_cache data")
    }
    System_Boundary(AccountService_boundary, "AccountService") {
        Container_Boundary(AccountService_AccountManagement_Domain_boundary, "AccountManagement Domain") {
            Container(AccountManagement, "AccountManagement", "Java Application", "AccountManagement [Context]")
        }
        Container_Boundary(AccountService_BalanceTracking_Domain_boundary, "BalanceTracking Domain") {
            Container(BalanceTracking, "BalanceTracking", "Java Application", "BalanceTracking [Context]")
        }
        ContainerDb(AccountService_account_db, "AccountService_account_db", "Database", "Stores account_db data")
        ContainerDb(AccountService_transaction_log, "AccountService_transaction_log", "Database", "Stores transaction_log data")
    }
    System_Boundary(Event_System_boundary, "Event_System") {
        ContainerQueue(Event_Queue, "Event_Queue", "Message Queue", "Handles asynchronous event processing and routing")
    }
    Rel(Customer, PaymentProcessing, "Triggers")
    Rel(Customer, AccountManagement, "Triggers")
    Rel(TransactionValidation, TransactionValidation, "Triggers")
    Rel(CRON, PaymentProcessing, "Triggers")
    Rel(PaymentProcessing, AccountManagement, "to verify source account", "Service API")
    Rel(PaymentProcessing, BalanceTracking, "to reserve funds", "Service API")
    Rel(PaymentProcessing, AccountManagement, "to verify destination account", "Service API")
    Rel(TransactionValidation, AccountManagement, "to freeze account", "Service API")
    Rel(PaymentProcessing, AccountManagement, "to get scheduled payments", "Service API")
    Rel(BalanceTracking, Event_Queue, "Funds Reserved", "Event Publishing")
    Rel(PaymentProcessing, Event_Queue, "Transfer Completed", "Event Publishing")
    Rel(TransactionValidation, Event_Queue, "Account Frozen", "Event Publishing")
    Rel(CustomerNotification, Event_Queue, "bank security team", "Event Publishing")
    Rel(PaymentProcessing, Event_Queue, "Scheduled Payments Processed", "Event Publishing")
    Rel(Event_Queue, PaymentProcessing, "Funds Reserved", "Event Delivery")
    Rel(Event_Queue, CustomerNotification, "Transfer Completed", "Event Delivery")
    Rel(Event_Queue, CustomerNotification, "Account Frozen", "Event Delivery")
