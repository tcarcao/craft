@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName SansSerif

' Domain styling with frames
skinparam frame {
  BackgroundColor #E1BEE7
  BorderColor #9370DB
  BorderThickness 2
  FontColor black
  FontSize 11
  FontStyle bold
}

skinparam queue {
  BackgroundColor #FFE4B5
  BorderColor #666666
  FontSize 10
}

skinparam actor {
  BackgroundColor white
  BorderColor black
}

' Domains as frames
frame "Subscriptions" as Subscriptions
frame "re/billing" as re_billing

cloud "External" as External

' Domain queues
queue "Subscriptions events" as Subscriptions_events

' Workflow flows
External --> Subscriptions : 1. vas.VasApplied
Subscriptions ->> re_billing : 2. for a fresh charge attempt (1! & 2!)
Subscriptions ->> Subscriptions_events : 3. vas.VasFulfilled

@enduml