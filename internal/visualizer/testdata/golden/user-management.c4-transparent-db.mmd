C4Container
    title Container Diagram - Architecture (transparent mode)
    Person(Business_User, "Business_User", "External user")
    System_Boundary(CommsService_boundary, "CommsService") {
        Container(CommsService_Application, "CommsService Application", "Application", "Core business logic for CommsService domains: Notifier")
    }
    System_Boundary(Event_System_boundary, "Event_System") {
        ContainerQueue(Event_Queue, "Event_Queue", "Message Queue", "Handles asynchronous event processing and routing")
    }
    System_Boundary(Gateway_boundary, "Gateway") {
        Container(APIGateway, "APIGateway", "Gateway", "Gateway composed by: LoadBalancer → APIGateway | Modifiers: LoadBalancer[ssl:true], APIGateway[type:nginx]")
    }
    System_Boundary(Presentation_boundary, "Presentation") {
        Container(WebApp, "WebApp", "React Frontend", " [framework:react, ssl]")
        Container(MobileApp, "MobileApp", "Mobile App", "")
    }
    System_Boundary(UserService_boundary, "UserService") {
        Container(UserService_Application, "UserService Application", "Go Application", "Core business logic for UserService domains: Authentication, Profile")
        ContainerDb(UserService_user_db, "UserService_user_db", "Database", "Stores user_db data")
    }
    Rel(Business_User, WebApp, "Uses")
    Rel(Business_User, MobileApp, "Uses")
    Rel(WebApp, APIGateway, "API Requests", "HTTPS/REST")
    Rel(MobileApp, APIGateway, "API Requests", "HTTPS/REST")
    Rel(APIGateway, UserService_Application, "Routes business logic requests", "HTTP/gRPC")
    Rel(UserService_Application, CommsService_Application, "send welcome email", "Service API")
    Rel(UserService_Application, UserService_user_db, "Reads/Writes data", "Database Protocol")
    Rel(UserService_Application, Event_Queue, "User Registered", "Event Publishing")
    Rel(Event_Queue, UserService_Application, "User Registered", "Event Delivery")
