@startuml
!include <C4/C4_Container.puml>
!include <tupadr3/devicons/database>
!include <tupadr3/devicons2/postgresql>
!include <tupadr3/devicons/mysql>
!include <tupadr3/devicons2/redis>
!include <tupadr3/devicons2/mongodb>
!include <tupadr3/devicons2/go>
!include <tupadr3/devicons2/java>
!include <tupadr3/devicons2/javascript>
!include <tupadr3/devicons2/python>
!include <tupadr3/font-awesome-5/code>
!include <tupadr3/font-awesome-5/mobile>
!include <tupadr3/font-awesome-5/globe>
!include <tupadr3/font-awesome-5/shield_alt>
!include <tupadr3/font-awesome-5/list>


LAYOUT_WITH_LEGEND()

title Container Diagram - Architecture (transparent mode)

Person(Business_User, "Business_User", "External user")
System_Ext(CronScheduler, "CronScheduler", "External system")
Person(Customer_Support, "Customer_Support", "External user")

System_Boundary(Event_System_boundary, "Event_System") {
    ContainerQueue(Event_Queue, "Event_Queue", "Message Queue", "Handles asynchronous event processing and routing", $sprite="list")
}

System_Boundary(Gateway_boundary, "Gateway") {
    Container(APIGateway, "APIGateway", "Gateway", "Gateway composed by: LoadBalancer → APIGateway | Modifiers: LoadBalancer[ssl:true], APIGateway[type:nginx]", $sprite="shield_alt")
}

System_Boundary(NotificationService_boundary, "NotificationService") {
    Container(NotificationService_Application, "NotificationService Application", "Python Application", "Core business logic for NotificationService domains: EmailNotifier, SMSNotifier, PushNotifier", $sprite="python")
    ContainerDb(NotificationService_rabbitmq, "NotificationService_rabbitmq", "Database", "Stores rabbitmq data", $sprite="database")
}

System_Boundary(OrderService_boundary, "OrderService") {
    Container(OrderService_Application, "OrderService Application", "TypeScript Application", "Core business logic for OrderService domains: OrderManagement, Payment, Shipping", $sprite="javascript")
    ContainerDb(OrderService_postgresql, "OrderService_postgresql", "PostgreSQL Database", "Stores postgresql data", $sprite="postgresql")
    ContainerDb(OrderService_kafka, "OrderService_kafka", "Database", "Stores kafka data", $sprite="database")
}

System_Boundary(Presentation_boundary, "Presentation") {
    Container(WebApp, "WebApp", "React Frontend", " [framework:react, ssl:true]", $sprite="code")
    Container(MobileApp, "MobileApp", "Flutter Frontend", " [framework:flutter]", $sprite="code")
}

System_Boundary(ProductService_boundary, "ProductService") {
    Container(ProductService_Application, "ProductService Application", "Java Application", "Core business logic for ProductService domains: Catalog, Inventory, Pricing", $sprite="java")
    ContainerDb(ProductService_postgresql, "ProductService_postgresql", "PostgreSQL Database", "Stores postgresql data", $sprite="postgresql")
    ContainerDb(ProductService_redis, "ProductService_redis", "Redis Cache", "Stores redis data", $sprite="redis")
}

System_Boundary(UserService_boundary, "UserService") {
    Container(UserService_Application, "UserService Application", "Go Application", "Core business logic for UserService domains: Authentication, Profile, Preferences", $sprite="go")
    ContainerDb(UserService_postgresql, "UserService_postgresql", "PostgreSQL Database", "Stores postgresql data", $sprite="postgresql")
}

Rel(Business_User, WebApp, "Uses")
Rel(Business_User, MobileApp, "Uses")
Rel(CronScheduler, WebApp, "Uses")
Rel(CronScheduler, MobileApp, "Uses")
Rel(Customer_Support, WebApp, "Uses")
Rel(Customer_Support, MobileApp, "Uses")
Rel(WebApp, APIGateway, "API Requests", "HTTPS/REST")
Rel(MobileApp, APIGateway, "API Requests", "HTTPS/REST")
Rel(APIGateway, NotificationService_Application, "Routes business logic requests", "HTTP/gRPC")
Rel(APIGateway, OrderService_Application, "Routes business logic requests", "HTTP/gRPC")
Rel(APIGateway, ProductService_Application, "Routes business logic requests", "HTTP/gRPC")
Rel(APIGateway, UserService_Application, "Routes business logic requests", "HTTP/gRPC")
Rel(UserService_Application, UserService_postgresql, "Reads/Writes data", "Database Protocol")
Rel(ProductService_Application, ProductService_postgresql, "Reads/Writes data", "Database Protocol")
Rel(ProductService_Application, ProductService_redis, "Reads/Writes data", "Database Protocol")
Rel(OrderService_Application, OrderService_postgresql, "Reads/Writes data", "Database Protocol")
Rel(OrderService_Application, OrderService_kafka, "Reads/Writes data", "Database Protocol")
Rel(NotificationService_Application, NotificationService_rabbitmq, "Reads/Writes data", "Database Protocol")
Rel(UserService_Application, Event_Queue, "UserRegistered", "Event Publishing")
Rel(OrderService_Application, Event_Queue, "PaymentCompleted", "Event Publishing")
Rel(OrderService_Application, Event_Queue, "OrderConfirmed", "Event Publishing")
Rel(ProductService_Application, Event_Queue, "StockLevelsUpdated", "Event Publishing")
Rel(ProductService_Application, Event_Queue, "CatalogUpdated", "Event Publishing")
Rel(OrderService_Application, Event_Queue, "OrderUpdated", "Event Publishing")
Rel(UserService_Application, Event_Queue, "PasswordChanged", "Event Publishing")
Rel(Event_Queue, UserService_Application, "UserRegistered", "Event Delivery")
Rel(Event_Queue, OrderService_Application, "PaymentCompleted", "Event Delivery")
Rel(Event_Queue, NotificationService_Application, "OrderConfirmed", "Event Delivery")
Rel(Event_Queue, ProductService_Application, "StockLevelsUpdated", "Event Delivery")
Rel(Event_Queue, NotificationService_Application, "CatalogUpdated", "Event Delivery")
Rel(Event_Queue, NotificationService_Application, "OrderUpdated", "Event Delivery")
Rel(Event_Queue, NotificationService_Application, "PasswordChanged", "Event Delivery")

@enduml