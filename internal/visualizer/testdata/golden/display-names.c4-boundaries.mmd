C4Container
    title Container Diagram - Architecture (boundaries mode)
    System_Ext(CRON, "the hourly clock that<br/>rebuilds the prices", "Scheduler")
    Person(Seller, "the seller", "External user")
    System_Boundary(Event_System_boundary, "Event_System") {
        ContainerQueue(Event_Queue, "Event_Queue", "Message Queue", "Handles asynchronous event processing and routing")
    }
    System_Boundary(nmf_boundary, "nmf") {
        Container_Boundary(nmf_nmf_monetization_Domain_boundary, "nMF, the money engine<br/>Domain") {
            Container(nmf_monetization, "nMF, the money engine", "Go Application", "nmf_monetization [Context]")
        }
    }
    System_Boundary(portfolio_boundary, "portfolio") {
        Container_Boundary(portfolio_portfoliovalue_Domain_boundary, "portfolio value,<br/>recomputed on every<br/>price change Domain") {
            Container(portfoliovalue, "portfolio value,<br/>recomputed on every<br/>price change", "PHP Application", "portfoliovalue [Context]")
        }
        Container_Boundary(portfolio_invoicearchive_Domain_boundary, "invoicearchive Domain") {
            Container(invoicearchive, "invoicearchive", "PHP Application", "invoicearchive [Context]")
        }
    }
    Rel(CRON, nmf_monetization, "Triggers")
    Rel(Seller, portfoliovalue, "Triggers")
    Rel(portfoliovalue, nmf_monetization, "for the price list", "Service API")
    Rel(nmf_monetization, Event_Queue, "pricing.PricesChanged", "Event Publishing")
    Rel(Event_Queue, portfoliovalue, "pricing.PricesChanged", "Event Delivery")
