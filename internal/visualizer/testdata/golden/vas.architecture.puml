@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName SansSerif

' Subdomain styling with frames
skinparam frame {
  BackgroundColor #E6F3FF
  BorderColor #4A90E2
  BorderThickness 2
  FontColor black
  FontSize 12
  FontStyle bold
}

skinparam queue {
  BackgroundColor #FFE4B5
  BorderColor #666666
  FontSize 10
}

skinparam rectangle {
  BackgroundColor #F0F8FF
  BorderColor #4169E1
  BorderThickness 3
  FontColor #000080
  FontSize 14
  FontStyle bold
}

' Service boundaries
rectangle "VasApplicationServiceA" as VasApplicationServiceA {
  frame "VasApplication" as VasApplication
}
rectangle "VasManagementService" as VasManagementService {
  frame "VASFulfillment" as VASFulfillment
  frame "VASScheduler" as VASScheduler
  frame "VasLifecycle" as VasLifecycle
}

' Domain queues
queue "VASFulfillment events" as VASFulfillment_events
queue "VASScheduler events" as VASScheduler_events
queue "VasApplication events" as VasApplication_events

' Subdomain connections
VASFulfillment --> VasLifecycle
VASFulfillment --> VASFulfillment_events
VASScheduler --> VASScheduler_events
VasApplication --> VasApplication_events
VASFulfillment_events --> VasApplication
VasApplication_events --> VASFulfillment
VasApplication_events --> VasLifecycle

@enduml