@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName SansSerif

' Domain styling with frames
skinparam frame {
  BackgroundColor #E1BEE7
  BorderColor #9370DB
  BorderThickness 2
  FontColor black
  FontSize 11
  FontStyle bold
}

skinparam queue {
  BackgroundColor #FFE4B5
  BorderColor #666666
  FontSize 10
}

skinparam actor {
  BackgroundColor white
  BorderColor black
}

' Domains as frames
frame "VASScheduling" as VASScheduling
frame "Wallet" as Wallet

' Actors
actor "Business_User" as Business_User
actor "VASMgmt" as VASMgmt

' Domain queues
queue "Wallet events" as Wallet_events

' Workflow flows
Business_User --> VASScheduling : 1. unschedules a VAS scheduling
VASScheduling ->> Wallet : 2. to cancel the VAS reservation
Wallet -> Wallet : 3. cancels VAS reservation
Wallet ->> Wallet_events : 4. VAS Reservation Canceled
VASScheduling -> VASScheduling : 5. cancels the VAS schedule
VASMgmt --> VASMgmt : 6. identifies a scheduled VAS to apply
VASMgmt -> VASMgmt : 7. applies a VAS and stores details until when its valid

@enduml