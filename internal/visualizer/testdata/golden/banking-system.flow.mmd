flowchart LR
    CRON(["CRON"])
    Customer(["Customer"])
    TransactionValidation(["TransactionValidation"])
    AccountManagement["AccountManagement"]
    BalanceTracking["BalanceTracking"]
    CustomerNotification["CustomerNotification"]
    PaymentProcessing["PaymentProcessing"]
    BalanceTracking_events[("BalanceTracking events")]
    CustomerNotification_events[("CustomerNotification events")]
    PaymentProcessing_events[("PaymentProcessing events")]
    TransactionValidation_events[("TransactionValidation events")]
    Customer -- "1. initiates transfer" --> PaymentProcessing
    PaymentProcessing -- "2. to verify source account" --> AccountManagement
    PaymentProcessing -- "3. to check transfer limits" --> TransactionValidation
    TransactionValidation -- "4. validates transaction rules" --> TransactionValidation
    PaymentProcessing -- "5. to reserve funds" --> BalanceTracking
    BalanceTracking -- "6. Funds Reserved" --> BalanceTracking_events
    BalanceTracking_events -- "7. Funds Reserved" --> PaymentProcessing
    PaymentProcessing -- "8. to verify destination account" --> AccountManagement
    PaymentProcessing -- "9. executes fund transfer" --> PaymentProcessing
    BalanceTracking -- "10. updates account balances" --> BalanceTracking
    PaymentProcessing -- "11. Transfer Completed" --> PaymentProcessing_events
    PaymentProcessing_events -- "12. Transfer Completed" --> CustomerNotification
    CustomerNotification -- "13. sends confirmation to both accounts" --> CustomerNotification
    Customer -- "14. checks balance" --> AccountManagement
    AccountManagement -- "15. to get current balance" --> BalanceTracking
    BalanceTracking -- "16. calculates available balance" --> BalanceTracking
    AccountManagement -. "17. returns balance information" .-> Customer
    TransactionValidation -- "18. to freeze account" --> AccountManagement
    AccountManagement -- "19. applies security hold" --> AccountManagement
    TransactionValidation -- "20. Account Frozen" --> TransactionValidation_events
    TransactionValidation_events -- "21. Account Frozen" --> CustomerNotification
    CustomerNotification -- "22. sends security alert to customer" --> CustomerNotification
    CustomerNotification -- "23. bank security team" --> CustomerNotification_events
    CRON -- "24. triggers scheduled payments" --> PaymentProcessing
    PaymentProcessing -- "25. to get scheduled payments" --> AccountManagement
    PaymentProcessing -- "26. processes each scheduled payment" --> PaymentProcessing
    BalanceTracking -- "27. updates balances for processed payments" --> BalanceTracking
    PaymentProcessing -- "28. Scheduled Payments Processed" --> PaymentProcessing_events
