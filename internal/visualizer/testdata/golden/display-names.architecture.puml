@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName SansSerif

' Subdomain styling with frames
skinparam frame {
  BackgroundColor #E6F3FF
  BorderColor #4A90E2
  BorderThickness 2
  FontColor black
  FontSize 12
  FontStyle bold
}

skinparam queue {
  BackgroundColor #FFE4B5
  BorderColor #666666
  FontSize 10
}

skinparam rectangle {
  BackgroundColor #F0F8FF
  BorderColor #4169E1
  BorderThickness 3
  FontColor #000080
  FontSize 14
  FontStyle bold
}

' Service boundaries
rectangle "nmf" as nmf {
  frame "nMF, the money engine" as nmf_monetization
}
rectangle "portfolio" as portfolio {
  frame "invoicearchive" as invoicearchive
  frame "portfolio value,\nrecomputed on every\nprice change" as portfoliovalue
}

' Domain queues
queue "nMF, the money engine\nevents" as nmf_monetization_events

' Subdomain connections
nmf_monetization --> portfoliovalue
nmf_monetization --> nmf_monetization_events
portfoliovalue --> nmf_monetization
nmf_monetization_events --> portfoliovalue

@enduml