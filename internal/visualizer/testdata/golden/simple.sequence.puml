@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

actor "Customer" as Customer
participant "Offering" as Offering
participant "Order" as Order
participant "PaymentProvider" as PaymentProvider
actor "Business_User" as Business_User
participant "VASScheduling" as VASScheduling
participant "Wallet" as Wallet
participant "OrderManagement" as OrderManagement
participant "OrderFulfilment" as OrderFulfilment
participant "WalletItemAddition" as WalletItemAddition
actor "CRON" as CRON
participant "OrderMgmt" as OrderMgmt
actor "VASMgmt" as VASMgmt
participant "Subscription" as Subscription
participant "Susbscription" as Susbscription

== C2C user purchases ==

group 1: when Customer decides to purchase a VAS
Customer -> Offering : decides to purchase a VAS
Offering --> Customer : returns available offering
end
group 2: when Customer asks Order to create an order
Customer -> Order : asks Order to create an order
Order -> Order : creates a draft Order
Order --> Customer : returns the url of the payment providers
end
group 3: when Customer pays for the order
Customer -> PaymentProvider : pays for the order
PaymentProvider -> PaymentProvider : confirms payment
PaymentProvider ->> PaymentProvider : notifies "PaymentCompleted"
end
group 4: when Order listens "PaymentCompleted"
PaymentProvider ->> Order : PaymentCompleted
Order -> Order : marks the Order as Paid
end

== VAS scheduled and no VAS in Wallet ==

group 1: when Business_User schedules VAS
Business_User -> VASScheduling : schedules VAS
VASScheduling -> Wallet : to reserve a VAS
Wallet -> Wallet : creates an unconfirmed VAS reservation
Wallet ->> Wallet : notifies "VAS Addition Request Approved"
VASScheduling -> VASScheduling : drafts a VAS schedule
end
group 2: when VASScheduling listens "VAS Addition Request Approved"
Wallet ->> VASScheduling : VAS Addition Request Approved
VASScheduling -> OrderManagement : to create an Order
OrderManagement ->> OrderManagement : notifies "Order Created"
OrderManagement -> OrderManagement : marks the Order as payment deferred
OrderManagement ->> OrderManagement : notifies "Order payment deferred"
end
group 3: when OrderFulfilment listens "Order payment deferred"
OrderManagement ->> OrderFulfilment : Order payment deferred
[-> OrderFulfilment : Order payment deferred (from OrderMgmt)
OrderFulfilment -> WalletItemAddition : to fulfil the addition request
WalletItemAddition -> Wallet : to add VAS
Wallet ->> Wallet : notifies "VAS added"
end
group 4: when OrderFulfilment listens "VAS added"
Wallet ->> OrderFulfilment : VAS added
OrderFulfilment -> OrderManagement : to mark the Order as fulfiled
OrderManagement ->> OrderManagement : notifies "Order completed"
end

== VAS scheduled and VAS in Wallet ==

Business_User -> VASScheduling : schedules VAS
VASScheduling -> Wallet : to reserve a VAS
Wallet -> Wallet : reserves a VAS
Wallet ->> Wallet : notifies "VAS Reserved"
VASScheduling -> VASScheduling : creates a VAS schedule

== VAS unscheduled ==

Business_User -> VASScheduling : unschedules a VAS scheduling
VASScheduling -> Wallet : to cancel the VAS reservation
Wallet -> Wallet : cancels VAS reservation
Wallet ->> Wallet : notifies "VAS Reservation Canceled"
VASScheduling -> VASScheduling : cancels the VAS schedule

== VAS expires ==

CRON -> Wallet : identifies a VAS expiring
Wallet -> Wallet : removes VAS
Wallet ->> Wallet : notifies "VAS Expired"

== Purchase VAS schedule and its renewal (ideal scenario) ==

group 1: when Business_User schedules a VAS
Business_User -> OrderMgmt : schedules a VAS
OrderMgmt -> OrderMgmt : creates an "Order with two items to fulfil: VAS and VAS Subscription"
OrderMgmt ->> OrderMgmt : notifies "Order Created"
OrderMgmt -> OrderMgmt : marks the Order as payment deferred
OrderMgmt ->> OrderMgmt : notifies "Order payment deferred"
end
group 2: when OrderFulfilment listens "Order payment deferred"
[-> OrderFulfilment : Order payment deferred (from OrderManagement)
OrderMgmt ->> OrderFulfilment : Order payment deferred
OrderFulfilment -> VASMgmt : to schedule the VAS
VASMgmt -> VASMgmt : schedules the VAS for future application
VASMgmt ->> VASMgmt : notifies "VAS scheduled"
end
group 3: when OrderFulfilment listens "VAS scheduled"
VASMgmt ->> OrderFulfilment : VAS scheduled
OrderFulfilment -> Subscription : to create a VAS Subscription
Subscription -> Subscription : creates a VAS Subscription with the details
OrderFulfilment -> OrderFulfilment : marks the vas subscription item as Fulfiled
end

== Purchase VAS schedule and its renewal (current possible scenario) ==

group 1: when Business_User schedules a VAS
Business_User -> VASMgmt : schedules a VAS
VASMgmt -> VASMgmt : schedules a VAS for future application
VASMgmt ->> VASMgmt : notifies "VAS scheduled with subscription included"
end
group 2: when Subscription listens "VAS scheduled with subscription included"
VASMgmt ->> Subscription : VAS scheduled with subscription included
Subscription -> Subscription : creates a VAS Subscription with the details
end

== Scheduled VAS Applied ==

note over VASMgmt : identifies a scheduled VAS to apply
VASMgmt -> VASMgmt : applies a VAS and stores details until when its valid
VASMgmt ->> VASMgmt : notifies "VAS Applied"

== VAS Renewal Flow ==

group 1: when VASMgmt identifies a VAS expired
note over VASMgmt : identifies a VAS expired
VASMgmt -> VASMgmt : marks the VAS as expired
VASMgmt ->> VASMgmt : notifies "VAS expired"
end
group 2: when Subscription listens "VAS expired"
VASMgmt ->> Subscription : VAS expired
Subscription -> Subscription : checks if VAS has active associated subscription
Subscription -> VASMgmt : to "schedule/apply a new VAS"
Subscription -> Subscription : renews the VAS Subscription with the VAS
Susbscription ->> Susbscription : notifies "VAS Subscription Renewed"
end

== Stop Auto-Renewal ==

Business_User -> Subscription : stops the VAS Auto-Renewal
Subscription -> Subscription : cancels the subscription

@enduml