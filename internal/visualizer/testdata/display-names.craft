// Display names (2.27): the registry names contexts and actors once; the
// journey below uses only ids, and every view shows the display names.
actors {
    user Seller "the seller"
    scheduler CRON "the hourly clock that rebuilds the prices"
    system PriceProject "price project #2; EU"
}

domains {
    billing {
        nmf_monetization "nMF, the money engine"
        portfoliovalue "portfolio value, recomputed on every price change"
        invoicearchive
    }
}

services {
    nmf {
        contexts: nmf_monetization
        data-stores: pricing
        language: golang
    }
    portfolio {
        contexts: portfoliovalue, invoicearchive
        language: php
    }
}

surface nmf_monetization {
    callers: portfoliovalue
    query the price list  [getPrices]
}

use_case "Rebuild the price list" {
    when CRON fires the hourly refresh
        nmf_monetization asks PriceProject to resolve the template prices  [POST /pricing/resolve]
        nmf_monetization writes the pricing
        nmf_monetization notifies pricing.PricesChanged
}

use_case "Seller reads their portfolio value" {
    when Seller opens the portfolio page
        portfoliovalue asks nmf_monetization for the price list  [getPrices]
        nmf_monetization returns the price list
        portfoliovalue computes the value
        invoicearchive files the snapshot

    when portfoliovalue listens pricing.PricesChanged
        portfoliovalue recomputes every portfolio
}
